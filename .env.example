# Copy to .env and fill in. .env is gitignored. This example file IS committed - keep it value-free.

# Must be "sandbox" for the hackathon. The server refuses to start otherwise.
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox app credentials: developer.paypal.com > Apps & Credentials > (Sandbox) > your app
# Client ID is public (may go to the browser). Client Secret is SERVER-SIDE ONLY.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Webhooks: ID shown after you register the webhook URL on your sandbox app (needed to verify signatures)
PAYPAL_WEBHOOK_ID=

# Public base URL of this server (PayPal redirects buyers back here after approving)
APP_BASE_URL=http://localhost:3000
PORT=3000

# AI provider order: Claude if ANTHROPIC_API_KEY is set, else NVIDIA if NVIDIA_API_KEY is set, else offline rules.
# Claude (Anthropic) - server-side only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# NVIDIA API catalog (build.nvidia.com > Get API Key) - server-side only. Every request is metered:
# credits are counted down from NVIDIA_CREDITS (your starting balance) and persisted to AI_USAGE_FILE.
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_CREDITS=1000
NVIDIA_CREDITS_PER_REQUEST=1
AI_USAGE_FILE=data/ai-usage.json

# AG Grid Enterprise licence (sponsor). Validated in the browser, so it is served to the page; keep it out of git.
AG_GRID_LICENSE_KEY=

# Channel3 product catalog (sponsor) - server-side only. trychannel3.com > API Keys
CHANNEL3_API_KEY=

# Bryntum trial licence (sponsor; Scheduler/Calendar UI). Trial valid until 2026-12-21.
BRYNTUM_LICENSE_KEY=

# Hard limits for anything an agent can do with money (enforced in code, not just prompts)
MAX_AUTH_AMOUNT=1000
CURRENCY=USD

# Shared secret for the admin "approve settlement" action (human-in-the-loop)
ADMIN_TOKEN=
